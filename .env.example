# ============================================================
# .env.example — Variables d'environnement RAG-Souverain-Eval
# ============================================================
# Copier ce fichier vers .env et remplir les valeurs.
# .env est gitignored ; .env.example doit être commité (template).
# ============================================================


# ---- Multi-threading PyTorch (CPU) ------------------------------------------
# Mini-PC Ryzen AI 9 HX470 : 12 cores physiques / 24 threads logiques (SMT).
OMP_NUM_THREADS=12
MKL_NUM_THREADS=12


# ---- Hugging Face -----------------------------------------------------------
# Token pour rate limits + accès modèles gated (au cas où).
# Récupérer sur https://huggingface.co/settings/tokens (read-only suffit).
HF_TOKEN=hf_REPLACE_ME


# ---- OpenAI API (judge GPT-5 mini + génération API) -------------------------
# Budget contrôlé : voir configs/eval.yaml (max_api_budget_eur).
# Cache obligatoire sur les appels judge.
OPENAI_API_KEY=sk-REPLACE_ME


# ---- Qdrant (vector DB local Docker) ----------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333


# ---- Ollama (LLM local) -----------------------------------------------------
# Backend Vulkan activé via systemd override (cf. 6-setup-infra.md §2).
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3-local


# ---- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO